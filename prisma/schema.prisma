generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Shared types ────────────────────────────────────────────────────────────
// Localised text is stored as JSON: { en: string; tr: string; fr?: string }

model CourseCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      Json     // { en: string; tr: string; fr?: string }
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           Json           // { en: string; tr: string; fr?: string }
  subtitle        Json?          // { en: string; tr: string; fr?: string }
  description     Json           // { en: string; tr: string; fr?: string }
  outcomes        Json           // { en: string[]; tr: string[]; fr?: string[] }
  weeklyPlan      Json           // { en: WeekItem[]; tr: WeekItem[]; fr?: WeekItem[] }
  assessments     Json           // { en: AssessmentItem[]; tr: AssessmentItem[]; fr?: AssessmentItem[] }
  published       Boolean        @default(false)
  category        CourseCategory? @relation(fields: [categoryId], references: [id])
  categoryId      String?
  studentProjects StudentProject[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum PortfolioType {
  research
  project
  event
}

model PortfolioEntry {
  id          String        @id @default(cuid())
  type        PortfolioType
  title       Json          // { en: string; tr: string; fr?: string }
  description Json          // { en: string; tr: string; fr?: string }
  tags        String[]
  url         String?
  imageUrl    String?
  published   Boolean       @default(false)
  featured    Boolean       @default(false)
  date        DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AcademicEvent {
  id          String   @id @default(cuid())
  title       Json     // { en: string; tr: string; fr?: string }
  description Json?    // { en: string; tr: string; fr?: string }
  date        DateTime
  location    String?
  type        String?
  status      String   @default("Upcoming") // "Upcoming" | "Past"
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeachingMaterial {
  id        String   @id @default(cuid())
  title     Json     // { en: string; tr: string; fr?: string }
  type      String   // "presentation" | "note" | "template" | "dataset"
  fileUrl   String?
  course    String?
  semester  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentProject {
  id          String   @id @default(cuid())
  title       String
  description Json     // { en: string; tr: string; fr?: string }
  year        Int?
  course      Course?  @relation(fields: [courseId], references: [id])
  courseId    String?
  imageUrl    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ReflectionStatus {
  published
  forthcoming
  draft
}

model Reflection {
  id        String           @id @default(cuid())
  slug      String           @unique
  title     Json             // { en: string; tr: string; fr?: string }
  subtitle  Json?            // { en: string; tr: string; fr?: string }
  body      Json             // { en: string; tr: string; fr?: string }
  excerpt   Json?            // { en: string; tr: string; fr?: string }
  category  Json?            // { en: string; tr: string; fr?: string }
  status    ReflectionStatus @default(draft)
  featured  Boolean          @default(false)
  publishedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model LibraryResource {
  id          String   @id @default(cuid())
  category    String   // e.g. "Strategy", "Feasibility"
  title       String
  author      String?
  url         String?
  description Json?    // { en: string; tr: string; fr?: string }
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
