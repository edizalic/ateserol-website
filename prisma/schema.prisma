generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Shared types ────────────────────────────────────────────────────────────
// Localised text is stored as JSON: { en: string; tr: string; fr?: string }

model Category {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         Json              // { en: string; tr: string; fr: string }
  courses      Course[]
  reflections  Reflection[]
  libraryItems LibraryResource[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("CourseCategory")
}

model Course {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           Json           // { en: string; tr: string; fr?: string }
  subtitle        Json?          // { en: string; tr: string; fr?: string }
  description     Json           // { en: string; tr: string; fr?: string }
  outcomes        Json           // { en: string[]; tr: string[]; fr?: string[] }
  weeklyPlan      Json           // { en: WeekItem[]; tr: WeekItem[]; fr?: WeekItem[] }
  assessments     Json           // { en: AssessmentItem[]; tr: AssessmentItem[]; fr?: AssessmentItem[] }
  published       Boolean        @default(false)
  categories      Category[]
  studentProjects StudentProject[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum PortfolioType {
  research
  project
  event
}

model PortfolioEntry {
  id          String        @id @default(cuid())
  type        PortfolioType
  title       Json          // { en: string; tr: string; fr?: string }
  description Json          // { en: string; tr: string; fr?: string }
  tags        String[]
  url         String?
  imageUrl    String?
  published   Boolean       @default(false)
  featured    Boolean       @default(false)
  date        DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AcademicEvent {
  id          String   @id @default(cuid())
  title       Json     // { en: string; tr: string; fr?: string }
  description Json?    // { en: string; tr: string; fr?: string }
  date        DateTime
  location    String?
  type        String?
  status      String   @default("Upcoming") // "Upcoming" | "Past"
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeachingMaterial {
  id        String   @id @default(cuid())
  title     Json     // { en: string; tr: string; fr?: string }
  type      String   // "presentation" | "note" | "template" | "dataset"
  fileUrl   String?
  course    String?
  semester  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentProject {
  id          String   @id @default(cuid())
  title       String
  description Json     // { en: string; tr: string; fr?: string }
  year        Int?
  course      Course?  @relation(fields: [courseId], references: [id])
  courseId    String?
  imageUrl    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ReflectionStatus {
  published
  forthcoming
  draft
}

model Reflection {
  id        String           @id @default(cuid())
  slug      String           @unique
  title     Json             // { en: string; tr: string; fr?: string }
  subtitle  Json?            // { en: string; tr: string; fr?: string }
  body      Json             // { en: string; tr: string; fr?: string }
  excerpt    Json?            // { en: string; tr: string; fr?: string }
  categories Category[]
  status     ReflectionStatus @default(draft)
  featured  Boolean          @default(false)
  publishedAt DateTime?
  imageUrl  String?
  files     PostFile[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model PostFile {
  id           String     @id @default(cuid())
  reflectionId String
  reflection   Reflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)
  filename     String     // stored filename on disk (uuid-based)
  originalName String     // original uploaded filename
  mimeType     String
  size         Int        // file size in bytes
  createdAt    DateTime   @default(now())
}

model LibraryResource {
  id          String     @id @default(cuid())
  categories  Category[]
  title       String
  author      String?
  url         String?
  description Json?    // { en: string; tr: string; fr?: string }
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Generic file attachments for any entity type (portfolio, course, event, etc.)
model EntityFile {
  id           String   @id @default(cuid())
  entityType   String   // 'portfolio' | 'student-project' | 'event' | 'course' | 'library' | 'material'
  entityId     String
  filename     String   // stored filename on disk (uuid-based)
  originalName String   // original uploaded filename
  mimeType     String
  size         Int      // file size in bytes
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Generic uploaded image/file not tied to a specific record.
/// Used for imageUrl and fileUrl fields across the admin.
model MediaFile {
  id        String   @id @default(cuid())
  filename  String   // stored filename on disk (uuid-based)
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}
